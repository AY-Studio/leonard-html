# Dependencies
node_modules/

# Build output
dist/

# Figma source files (large binaries — not tracked)
*.fig

# Vite / build caches
.vite/
.cache/
*.local

# Accessibility tooling — keep the page list, ignore generated reports.
# `a11y/*` rather than `a11y/`: git cannot re-include a file inside a directory
# it has already excluded, so the directory itself must stay un-ignored for the
# negation below to take effect.
a11y/*
!a11y/urls.txt

# Generated audit runs
audits/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
